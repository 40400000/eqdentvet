# Payload CMS — required.
# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# Postgres connection string. Neon / Vercel Postgres injects POSTGRES_URL
# automatically when you connect the integration. For local development run:
#   vercel env pull .env
# or paste the Neon "DATABASE_URL" / "POSTGRES_URL" here yourself.
POSTGRES_URL=

# Optional: Vercel Blob token. Auto-injected by the Vercel Blob integration.
# Without it, uploads attempt to write to ./media (won't work on Vercel).
BLOB_READ_WRITE_TOKEN=

# Existing site env (kept for reference)
RESEND_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
