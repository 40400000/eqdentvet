# Payload CMS — required.
# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# Database (SQLite). For local dev a file-based URL works.
# For Vercel/serverless production use a Turso (libsql) URL: libsql://...
DATABASE_URI=file:./eqdent.db

# Optional: Vercel Blob token. When set, uploaded media is stored
# in Vercel Blob. When unset, uploads are written to ./media on disk.
BLOB_READ_WRITE_TOKEN=

# Existing site env (kept for reference)
RESEND_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
